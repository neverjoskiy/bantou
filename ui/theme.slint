// Material 3 Expressive design tokens for Bantou.
// Color roles follow the M3 baseline scheme (seed #6750A4); shape scale and
// motion curves follow the Expressive specs.

export global Theme {
    // ── Color roles ────────────────────────────────────────────────
    out property <color> primary: #6750A4;
    out property <color> on-primary: #FFFFFF;
    out property <color> primary-container: #EADDFF;
    out property <color> on-primary-container: #21005D;
    out property <color> secondary-container: #E8DEF8;
    out property <color> on-secondary-container: #1D192B;
    out property <color> tertiary-container: #FFD8E4;
    out property <color> on-tertiary-container: #31111D;
    out property <color> surface: #FEF7FF;
    out property <color> on-surface: #1D1B20;
    out property <color> on-surface-variant: #49454F;
    out property <color> surface-container-lowest: #FFFFFF;
    out property <color> surface-container-low: #F7F2FA;
    out property <color> surface-container: #F3EDF7;
    out property <color> surface-container-high: #ECE6F0;
    out property <color> surface-container-highest: #E6E0E9;
    out property <color> outline: #79747E;
    out property <color> outline-variant: #CAC4D0;
    out property <color> error: #B3261E;
    out property <color> on-error: #FFFFFF;
    out property <color> error-container: #F9DEDC;
    out property <color> inverse-surface: #322F35;
    out property <color> inverse-on-surface: #F5EFF7;
    out property <color> inverse-primary: #D0BCFF;
    out property <color> scrim: #000000;

    // ── Shape scale (Expressive) ───────────────────────────────────
    out property <length> shape-corner-xs: 4px;
    out property <length> shape-corner-s: 8px;
    out property <length> shape-corner-m: 12px;
    out property <length> shape-corner-l: 16px;
    out property <length> shape-corner-xl: 28px;
    out property <length> shape-corner-full: 999px;

    // ── Typography ─────────────────────────────────────────────────
    out property <length> font-display-s: 36px;
    out property <length> font-headline-s: 24px;
    out property <length> font-title-m: 16px;
    out property <length> font-title-s: 14px;
    out property <length> font-body-m: 14px;
    out property <length> font-body-s: 12px;
    out property <length> font-label-l: 14px;

    // ── Motion ─────────────────────────────────────────────────────
    // emphasized        cubic-bezier(0.2,  0,   0,   1)    — entrances/exits
    // emphasized-decel  cubic-bezier(0.05, 0.7, 0.1, 1)   — incoming content
    // emphasized-accel  cubic-bezier(0.3,  0,   0.8, 0.15) — outgoing content
    out property <duration> motion-short: 200ms;
    out property <duration> motion-medium: 350ms;
    out property <duration> motion-long: 500ms;
    // Slint easing proxies of the M3 curves
    out property <easing> ease-emphasized: cubic_bezier(0.2, 0.0, 0.0, 1.0);
    out property <easing> ease-decelerate: cubic_bezier(0.05, 0.7, 0.1, 1.0);
    out property <easing> ease-accelerate: cubic_bezier(0.3, 0.0, 0.8, 0.15);

    // ── Elevation (surface tint steps, dark surfaces at 8% tint) ──
    out property <length> elevation-1: 1px;
    out property <length> elevation-3: 3px;
    out property <length> elevation-5: 5px;

    // ── Layout metrics ─────────────────────────────────────────────
    out property <length> rail-width-collapsed: 80px;
    out property <length> rail-width-expanded: 260px;
    out property <length> urlbar-height: 56px;
    out property <length> tabbar-height: 48px;
    out property <length> tab-width: 180px;
    out property <length> fab-size: 56px;
}
